:3000 {

    log {
        output stdout
        format json
    }
    
    handle /internet-status {
        rewrite * /status
        reverse_proxy internet-status:8080
    }

    handle /glances-memory {
        rewrite * /api/4/mem
        reverse_proxy glances:61208
    }

    handle /tailscale/dashboard {
            reverse_proxy internet-status:8080
        }
        
    handle /tailscale {
        reverse_proxy internet-status:8080
    }
    
    handle /network {
        reverse_proxy internet-status:8080
    }
    
	@speedtestAllowed {
	        path /speedtest/run
	        method POST
	        remote_ip 127.0.0.1/8 ::1 192.168.0.0/24 100.64.0.0/10 172.18.0.1
	    }
	
	    handle @speedtestAllowed {
	        reverse_proxy internet-status:8080
	    }
	
	    handle /speedtest/run {
	        respond "Forbidden" 403
	    }
	    
    handle /speedtest {
        reverse_proxy internet-status:8080
    }
    
    handle {
        reverse_proxy homepage:3000
    }
    
}
