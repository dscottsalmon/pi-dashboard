[Unit]
Description=Pi Dashboard Internet Connectivity Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scottishpro
Group=scottishpro
WorkingDirectory=/home/scottishpro/pi-dashboard
ExecStart=/usr/bin/python3 -u /home/scottishpro/pi-dashboard/monitor/internet_monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
